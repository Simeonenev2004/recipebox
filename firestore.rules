rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    function recipeOwner(recipeId) {
      return get(/databases/$(database)/documents/recipes/$(recipeId)).data.ownerId;
    }

    function hasValidFields() {
      let data = request.resource.data;
      return data.title is string
        && data.title.size() >= 3
        && data.title.size() <= 80
        && data.category in ['Breakfast', 'Lunch', 'Dinner', 'Dessert', 'Salad', 'Soup', 'Drinks']
        && data.imageUrl is string
        && data.prepTime is number
        && data.prepTime >= 1
        && data.prepTime <= 1440
        && data.servings is number
        && data.servings >= 1
        && data.servings <= 50
        && data.ingredients is list
        && data.ingredients.size() >= 1
        && data.instructions is string
        && data.instructions.size() >= 10;
    }

    function keepsProtectedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['ownerId', 'ownerName', 'createdAt']);
    }

    match /recipes/{recipeId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerName is string
        && hasValidFields();

      allow update: if isOwner()
        && keepsProtectedFields()
        && hasValidFields();

      allow delete: if isOwner();

      match /likes/{userId} {
        allow read: if true;

        allow create: if isSignedIn()
          && request.auth.uid == userId
          && recipeOwner(recipeId) != request.auth.uid;

        allow delete: if isSignedIn()
          && (request.auth.uid == userId || recipeOwner(recipeId) == request.auth.uid);
      }

      match /comments/{commentId} {
        allow read: if true;

        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 500;

        allow delete: if isSignedIn()
          && (resource.data.authorId == request.auth.uid
              || recipeOwner(recipeId) == request.auth.uid);
      }
    }

    match /users/{userId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
