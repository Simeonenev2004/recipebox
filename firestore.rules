rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    function hasValidFields() {
      let data = request.resource.data;
      return data.title is string
        && data.title.size() >= 3
        && data.title.size() <= 80
        && data.prepTime is number
        && data.servings is number
        && data.ingredients is list;
    }

    function keepsProtectedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['ownerId', 'ownerName', 'createdAt']);
    }

    match /recipes/{recipeId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && hasValidFields();

      allow update: if isOwner()
        && keepsProtectedFields()
        && hasValidFields();

      allow delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
